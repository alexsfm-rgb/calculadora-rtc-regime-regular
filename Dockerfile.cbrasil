# Imagem para rodar a Calculadora RTC (regime regular) em servidor (Railway/Render).
# Arquivo adicionado pela CBrasil; não existe no repositório da Receita, então o "Sync fork" não gera conflito.

FROM eclipse-temurin:25-jdk AS build
WORKDIR /app
COPY . .
RUN chmod +x mvnw \
 && mkdir -p calculadora/db \
 && ./mvnw -q flyway:migrate -Dflyway.configFiles=./flyway/flyway-pro.conf --batch-mode --errors \
 && ./mvnw -q clean package -DskipTests --batch-mode

FROM eclipse-temurin:25-jre
WORKDIR /app
COPY --from=build /app/target/api-regime-geral.jar app.jar
COPY --from=build /app/calculadora/db calculadora/db
ENV SERVER_PORT=8080
EXPOSE 8080
CMD ["sh", "-c", "java -XX:MaxRAMPercentage=75 -Dspring.profiles.active=offline -Dserver.port=${PORT:-8080} -jar app.jar"]
